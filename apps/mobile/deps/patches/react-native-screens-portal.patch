+// T3 Portal patch: a screen showing the bare Portal back chevron hides UIKit's back button, and
+// UIKit refuses both back swipes while its back button is hidden. While such a screen is on top,
+// UIKit's delegate answers with the back button shown, so its other checks (transitions, search,
+// a hidden bar) still apply.
+- (nullable UINavigationItem *)portalBackNavigationItem
+{
+  UINavigationItem *item = self.navigationController.topViewController.navigationItem;
+  return item.hidesBackButton && item.leftBarButtonItems.firstObject.tag == RNSPortalBackButtonTag ? item : nil;
+}
