 #if !TARGET_OS_TV
+// T3 Portal patch: UIKit draws iOS 26's glass circle behind the system back button and ignores
+// hidesSharedBackground on a backBarButtonItem. A pushed screen therefore hides the system button
+// and leads its own leading items with a bare chevron that pops the stack. The stack's pop gesture
+// delegate keeps the edge and full-screen back swipes for such a screen.
+- (BOOL)showsPortalBackButtonForController:(UIViewController *)controller
+                                navigation:(nullable UINavigationController *)navigation
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+  if (@available(iOS 26.0, *)) {
+    if (_configDataProvider == nil || _configDataProvider.backButtonHidden) {
+      return NO;
+    }
+    NSArray<UIViewController *> *viewControllers = navigation.viewControllers;
+    NSUInteger index = [viewControllers indexOfObject:controller];
+    // A screen not yet in the stack is being pushed onto it.
+    return index == NSNotFound ? viewControllers.count > 0 : index > 0;
+  }
+#endif // RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+  return NO;
+}
+
+- (NSArray<UIBarButtonItem *> *)leftItemsForController:(UIViewController *)controller
+{
+  return [self leftItemsForController:controller navigation:controller.navigationController];
+}
+
+- (NSArray<UIBarButtonItem *> *)leftItemsForController:(UIViewController *)controller
+                                            navigation:(nullable UINavigationController *)navigation
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+  if (@available(iOS 26.0, *)) {
+    if ([self showsPortalBackButtonForController:controller navigation:navigation]) {
+      if (_portalBackItem == nil) {
+        _portalBackItem = [[UIBarButtonItem alloc] initWithImage:[UIImage systemImageNamed:@"chevron.backward"]
+                                                           style:UIBarButtonItemStylePlain
+                                                          target:self
+                                                          action:@selector(popFromPortalBackButton)];
+        _portalBackItem.accessibilityLabel = @"Back";
+        _portalBackItem.tag = RNSPortalBackButtonTag;
+        _portalBackItem.hidesSharedBackground = YES;
+      }
+      return [@[ _portalBackItem ] arrayByAddingObjectsFromArray:_leadingBarButtonItems];
+    }
+  }
+#endif // RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+  return [_leadingBarButtonItems copy];
+}
+
+- (void)applyPortalBackButtonForController:(UIViewController *)controller
+                                navigation:(nullable UINavigationController *)navigation
+{
+  UINavigationItem *navItem = controller.navigationItem;
+  navItem.hidesBackButton = _configDataProvider.backButtonHidden ||
+      [self showsPortalBackButtonForController:controller navigation:navigation];
+  NSArray<UIBarButtonItem *> *leftItems = [self leftItemsForController:controller navigation:navigation];
+  if (![(navItem.leftBarButtonItems ?: @[]) isEqualToArray:leftItems]) {
+    [navItem setLeftBarButtonItems:leftItems animated:NO];
+  }
+}
+
+- (void)applyPortalBackButtonInNavigationController:(nullable UINavigationController *)navigation
+{
+  if (_configDataProvider == nil) {
+    return;
+  }
+  [self applyPortalBackButtonForController:[self requireScreenController] navigation:navigation];
+}
+
+- (void)popFromPortalBackButton
+{
+  // Goes through the stack's pop, which honours a screen that prevents native dismissal.
+  [_screenController.navigationController popViewControllerAnimated:YES];
+}
